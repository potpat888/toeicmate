generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  provider      String    @default("credentials")
  targetScore   Int       @default(700)
  currentScore  Int       @default(0)
  locale        String    @default("th")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      TestSession[]
  vocabCards    VocabCard[]
  chatSessions  ChatSession[]
  studyStreaks   StudyStreak[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model StudyStreak {
  id             String   @id @default(cuid())
  userId         String
  date           String   // YYYY-MM-DD
  minutesStudied Int      @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Question {
  id            String   @id @default(cuid())
  part          Int      // 1-7
  difficulty    String   @default("medium") // easy | medium | hard
  topic         String   // e.g. "tense", "preposition", "word_form", "conjunction"
  passage       String?  // reading passage text
  audioUrl      String?  // for Part 1-4
  imageUrl      String?  // for Part 1
  questionText  String
  choices       String   // JSON array of 4 strings
  answer        Int      // 0-3 index
  explanationTh String   // Thai explanation with why each wrong answer is wrong
  tags          String   @default("") // comma-separated tags
  createdAt     DateTime @default(now())

  answers Answer[]
}

model TestSession {
  id              String    @id @default(cuid())
  userId          String
  type            String    // PART_PRACTICE | FULL_MOCK | GRAMMAR_DRILL
  part            Int?      // null = full mock
  topic           String?   // for grammar drill
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  totalQuestions  Int       @default(10)
  correctCount    Int       @default(0)
  score           Int?      // estimated TOEIC score
  listeningScore  Int?
  readingScore    Int?
  resumeState     String?   // JSON: { currentIndex, answers }
  createdAt       DateTime  @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Answer[]
}

model Answer {
  id           String   @id @default(cuid())
  sessionId    String
  questionId   String
  chosen       Int      // 0-3 index, -1 = skipped
  isCorrect    Boolean
  timeSpentMs  Int      @default(0)
  createdAt    DateTime @default(now())

  session  TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model VocabCard {
  id            String   @id @default(cuid())
  userId        String
  term          String
  phonetic      String?
  meaningTh     String
  exampleEn     String?
  exampleTh     String?
  category      String   // Business Correspondence | Travel | HR | Contracts | General
  nextReviewAt  DateTime @default(now())
  interval      Int      @default(1)     // days
  easeFactor    Float    @default(2.5)
  repetitions   Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
}

model PhraseItem {
  id          String  @id @default(cuid())
  situation   String  // MEETING | EMAIL | PHONE | PRESENTATION | SMALLTALK
  phraseEn    String
  phraseTh    String
  notes       String? // tips about usage
  createdAt   DateTime @default(now())
}

model ChatSession {
  id           String   @id @default(cuid())
  userId       String
  scenario     String   // e.g. "job_interview", "client_meeting"
  messages     String   // JSON array of { role, content }
  feedbackJson String?  // JSON feedback after session ends
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
